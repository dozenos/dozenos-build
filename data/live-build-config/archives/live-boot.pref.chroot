# Always take live-boot from Debian, never from the DozenOS repository.
#
# The DozenOS delta on top of Debian's live-boot is shipped as drop-in files by
# dozenos-1x (/usr/lib/live/boot/9991-dozenos.sh and the initramfs-tools hooks), so
# the forked live-boot source package is no longer needed. dozenos-dev.pref.chroot
# pins the whole DozenOS repository at priority 999, which would otherwise let a
# stale forked live-boot win over Debian's regardless of version.
Package: live-boot live-boot-initramfs-tools live-boot-doc
Pin: release o=Debian
Pin-Priority: 1001
